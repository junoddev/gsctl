<?xml version="1.0" encoding="UTF-8"?>
<!-- Stand-ins for guard and security tests (tests/guards.rs). -->
<schemalist>
  <!-- A guarded fixed schema, like gnome-remote-desktop's. -->
  <schema id="org.gnome.desktop.remote-desktop.rdp" path="/org/gnome/desktop/remote-desktop/rdp/">
    <key name="enable" type="b">
      <default>false</default>
      <summary>Whether the RDP backend is enabled</summary>
    </key>
  </schema>

  <!-- A relocatable schema with an `enable` key, which could otherwise be
       pointed at a guarded schema's path with --path. -->
  <schema id="org.gsctl.test.reloc-enable">
    <key name="enable" type="b">
      <default>false</default>
      <summary>Enable this instance</summary>
    </key>
  </schema>

  <!-- A secret, like the HTTP proxy password. -->
  <schema id="org.gnome.system.proxy.http" path="/org/gnome/system/proxy/http/">
    <key name="host" type="s">
      <default>''</default>
      <summary>HTTP proxy host name</summary>
    </key>
    <key name="authentication-password" type="s">
      <default>''</default>
      <summary>HTTP proxy password</summary>
    </key>
  </schema>
</schemalist>
