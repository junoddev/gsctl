<?xml version="1.0" encoding="UTF-8"?>
<!-- Test schemas for gsctl. Compiled into a temp dir by tests/common/mod.rs. -->
<schemalist>
  <enum id="org.gsctl.test.Mode">
    <value nick="off" value="0"/>
    <value nick="on" value="1"/>
    <value nick="auto" value="2"/>
  </enum>
  <flags id="org.gsctl.test.Opts">
    <value nick="bold" value="1"/>
    <value nick="italic" value="2"/>
    <value nick="underline" value="4"/>
  </flags>

  <schema id="org.gsctl.test" path="/org/gsctl/test/">
    <key name="flag-b" type="b">
      <default>false</default>
      <summary>Enable the frobnicator</summary>
      <description>When true, the frobnicator runs on every refresh.</description>
    </key>
    <key name="count-i" type="i">
      <range min="0" max="100"/>
      <default>10</default>
      <summary>Number of widgets</summary>
      <description>How many widgets to show in the zanzibar panel.</description>
    </key>
    <key name="size-u" type="u">
      <default>300</default>
      <summary>Idle delay</summary>
      <description>Seconds of inactivity before the screen blanks.</description>
    </key>
    <key name="ratio-d" type="d">
      <range min="0.5" max="3.0"/>
      <default>1.0</default>
      <summary>Text scaling factor</summary>
    </key>
    <key name="name-s" type="s">
      <default>'Adwaita'</default>
      <summary>Theme name</summary>
    </key>
    <key name="list-as" type="as">
      <default>['one', 'two']</default>
      <summary>Favourite apps</summary>
      <description>Desktop file ids pinned to the quuxbar.</description>
    </key>
    <key name="dict-asv" type="a{sv}">
      <default>{}</default>
      <summary>Arbitrary options</summary>
    </key>
    <key name="dict-ass" type="a{ss}">
      <default>{'a': 'b'}</default>
      <summary>String map</summary>
    </key>
    <key name="pair-ii" type="(ii)">
      <default>(0, 0)</default>
      <summary>Window position</summary>
    </key>
    <key name="triple-sdb" type="(sdb)">
      <default>('x', 1.5, true)</default>
      <summary>Mixed tuple</summary>
    </key>
    <key name="sources-ass" type="a(ss)">
      <default>[('xkb', 'us')]</default>
      <summary>Pairs list</summary>
    </key>
    <key name="mode" enum="org.gsctl.test.Mode">
      <default>'auto'</default>
      <summary>Operating mode</summary>
    </key>
    <key name="opts" flags="org.gsctl.test.Opts">
      <default>['bold']</default>
      <summary>Text style flags</summary>
    </key>
    <key name="choice-s" type="s">
      <choices>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'left'</default>
      <summary>Dock side</summary>
    </key>
    <key name="maybe-s" type="ms">
      <default>nothing</default>
      <summary>Optional label</summary>
    </key>
    <key name="bytes-ay" type="ay">
      <default>b''</default>
      <summary>Raw bytes</summary>
    </key>
    <key name="big-x" type="x">
      <default>0</default>
      <summary>Signed 64-bit</summary>
    </key>
    <key name="big-t" type="t">
      <default>0</default>
      <summary>Unsigned 64-bit</summary>
    </key>
    <key name="byte-y" type="y">
      <default>0</default>
      <summary>Byte value</summary>
    </key>
    <key name="short-n" type="n">
      <default>0</default>
      <summary>Signed 16-bit</summary>
    </key>
    <key name="short-q" type="q">
      <default>0</default>
      <summary>Unsigned 16-bit</summary>
    </key>
    <key name="launch-count" type="u">
      <default>0</default>
      <summary>How often the app was launched (app state, not a preference)</summary>
    </key>
    <key name="locked-s" type="s">
      <default>'free'</default>
      <summary>Locked by the test admin database</summary>
    </key>
  </schema>

  <schema id="org.gsctl.test.reloc">
    <key name="name" type="s">
      <default>''</default>
      <summary>Binding name</summary>
    </key>
    <key name="binding" type="s">
      <default>''</default>
      <summary>Accelerator</summary>
    </key>
  </schema>

  <!-- A stand-in for a real GNOME schema, so guarded-key tests run hermetically. -->
  <schema id="org.gnome.desktop.screensaver" path="/org/gnome/desktop/screensaver/">
    <key name="lock-enabled" type="b">
      <default>true</default>
      <summary>Lock screen after blank</summary>
    </key>
    <key name="lock-delay" type="u">
      <default>0</default>
      <summary>Time before session lock</summary>
    </key>
    <!-- An unguarded key (default 0 here, not GNOME's 7200). -->
    <key name="logout-delay" type="u">
      <default>0</default>
      <summary>Time before logout option</summary>
    </key>
  </schema>

  <!-- Installed system-wide for system@gsctl.test, which names it only in its JS. -->
  <schema id="org.gnome.shell.extensions.gsctl-system" path="/org/gnome/shell/extensions/gsctl-system/">
    <key name="dock-side" type="s">
      <default>'left'</default>
      <summary>Dock side</summary>
    </key>
  </schema>

  <!-- Stand-in for org.gnome.shell, for `gsctl ext`. -->
  <schema id="org.gnome.shell" path="/org/gnome/shell/">
    <key name="enabled-extensions" type="as">
      <default>[]</default>
      <summary>UUIDs of extensions to enable</summary>
    </key>
    <key name="disabled-extensions" type="as">
      <default>[]</default>
      <summary>UUIDs of extensions to force disabling</summary>
    </key>
    <key name="disable-user-extensions" type="b">
      <default>false</default>
      <summary>Disable user extensions</summary>
    </key>
    <key name="favorite-apps" type="as">
      <default>[]</default>
      <summary>Favorite apps</summary>
    </key>
  </schema>

  <!-- Stand-ins for keybinding schemas, for `gsctl keys`. -->
  <schema id="org.gnome.desktop.wm.keybindings" path="/org/gnome/desktop/wm/keybindings/">
    <key name="switch-applications" type="as">
      <default>['&lt;Super&gt;Tab', '&lt;Alt&gt;Tab']</default>
      <summary>Switch applications</summary>
    </key>
    <key name="close" type="as">
      <default>['&lt;Alt&gt;F4']</default>
      <summary>Close window</summary>
    </key>
    <key name="minimize" type="as">
      <default>['&lt;Super&gt;h']</default>
      <summary>Hide window</summary>
    </key>
    <key name="show-desktop" type="as">
      <default>[]</default>
      <summary>Hide all normal windows</summary>
    </key>
  </schema>
  <schema id="org.gnome.shell.keybindings" path="/org/gnome/shell/keybindings/">
    <key name="toggle-overview" type="as">
      <default>['&lt;Super&gt;s']</default>
      <summary>Show the overview</summary>
    </key>
  </schema>

  <!-- Stand-ins for the media-keys schemas, for custom keybinding export/apply. -->
  <schema id="org.gnome.settings-daemon.plugins.media-keys" path="/org/gnome/settings-daemon/plugins/media-keys/">
    <key name="custom-keybindings" type="as">
      <default>[]</default>
      <summary>Custom keybindings</summary>
    </key>
    <key name="screensaver" type="as">
      <default>['&lt;Super&gt;l']</default>
      <summary>Lock screen</summary>
    </key>
  </schema>
  <schema id="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding">
    <key name="name" type="s">
      <default>''</default>
      <summary>Name</summary>
    </key>
    <key name="command" type="s">
      <default>''</default>
      <summary>Command</summary>
    </key>
    <key name="binding" type="s">
      <default>''</default>
      <summary>Binding</summary>
    </key>
  </schema>

  <!-- Stand-ins for Ptyxis: profiles are relocatable, listed by uuid. -->
  <schema id="org.gnome.Ptyxis" path="/org/gnome/Ptyxis/">
    <key name="profile-uuids" type="as">
      <default>[]</default>
      <summary>Profile uuids</summary>
    </key>
  </schema>
  <schema id="org.gnome.Ptyxis.Profile">
    <key name="label" type="s">
      <default>''</default>
      <summary>Label</summary>
    </key>
    <key name="opacity" type="d">
      <default>1.0</default>
      <summary>Opacity</summary>
    </key>
  </schema>
</schemalist>
